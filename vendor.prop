# Storage
external_storage.projid.enabled=1
external_storage.casefold.enabled=1
external_storage.sdcardfs.enabled=0

# Crypto
ro.hardware.keystore_desede=true
ro.crypto.metadata_init_delete_all_keys.enabled=true
ro.product.cuptsm=ONEPLUS|ESE|01|02
vendor.wv.oemcrypto.debug.enable_prov40=true

# Gatekeeper
vendor.gatekeeper.disable_spu=true
vendor.gatekeeper.is_security_level_spu=0

# USB Config
vendor.usb.use_ffs_mtp=1
persist.sys.oem.otg_support=true

# ADB / charger / OTG
# AOSP 16 generates system/build.prop from the Soong product config, so a
# device-tree system.prop is no longer consumed. These props are kept here
# because vendor.prop becomes vendor/build.prop, which the build appends to the
# recovery ramdisk's prop.default.
ro.adb.secure=0
ro.boot.dynamic_partitions=true
ro.charger.enable_suspend=1
persist.sys.isUsbOtgEnabled=true

# Vibrator
# /vendor/bin/hw/vendor.oplus.hardware.vibrator-service reads the LRA
# calibration range from these props. Values dumped from the device
# (getprop ro.oplus.haptic.lra_*).
ro.oplus.haptic.lra_value_set=true
ro.oplus.haptic.lra_range_min=160
ro.oplus.haptic.lra_range_gap1=164
ro.oplus.haptic.lra_range_gap2=168
ro.oplus.haptic.lra_range_gap3=172
ro.oplus.haptic.lra_range_gap4=176
ro.oplus.haptic.lra_range_max=180
ro.oplus.haptic.lra_level_low=162
ro.oplus.haptic.lra_level_middle=166
ro.oplus.haptic.lra_level_middle1=170
ro.oplus.haptic.lra_level_middle2=174
ro.oplus.haptic.lra_level_high=178
